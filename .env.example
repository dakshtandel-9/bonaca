# ============================================================================
#  Bonaca — local environment
#  This file is git-ignored. Copy the same keys into your host's dashboard
#  (Vercel → Settings → Environment Variables) before deploying.
# ============================================================================

# ---------------------------------------------------------------------------
#  CRM login  →  http://localhost:3000/admin
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs the admin session cookie. Change it and everyone is logged out.
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
#  Firebase (Firestore) — where the site content is stored
#  Firebase console → Project settings → Service accounts → Generate new key.
#  Leave blank and the CRM falls back to .data/content.json on disk, so you can
#  edit the whole site locally before any of this is set up.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key in quotes, newlines written as \n.
FIREBASE_PRIVATE_KEY=""
# Firestore document the whole site lives in.
FIREBASE_CONTENT_COLLECTION=bonaca-cms
FIREBASE_CONTENT_DOCUMENT=site-content

# ---------------------------------------------------------------------------
#  Cloudflare R2 — where uploaded images are stored
#  Cloudflare dashboard → R2 → Manage API tokens → Create (Object Read & Write).
#  Leave blank and uploads land in public/uploads/ instead.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public URL — either the r2.dev subdomain or your custom domain.
# e.g. https://pub-xxxxxxxx.r2.dev  or  https://media.bonaca.com
R2_PUBLIC_BASE_URL=
# Folder inside the bucket that uploads are written to.
R2_PREFIX=bonaca

# ---------------------------------------------------------------------------
#  Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com

# MCP — direct AI editing at /api/mcp (disabled until credentials are set)
# Optional machine token for Codex and other clients supporting bearer headers.
# Generate a separate secret with: openssl rand -hex 32
MCP_API_TOKEN=
# ChatGPT: configure an OAuth provider that issues JWT access tokens (RS256 or
# ES256) with the audience EXACTLY https://your-domain/api/mcp and permissions
# content:read / content:write. Restrict these permissions to your CRM editors.
# Copy the exact issuer and jwks_uri from the provider's discovery metadata.
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
# Optional comma-separated browser origins (e.g. an MCP Inspector origin).
# Requests without an Origin header are supported. The site's origin is allowed.
MCP_ALLOWED_ORIGINS=
